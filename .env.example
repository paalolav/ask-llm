# Copy to ~/.config/ask-llm.env and fill in.
# Env vars of the same name override these values.

# OpenAI-compatible /v1/chat/completions endpoint.
# Examples:
#   Local LiteLLM:    http://localhost:4000/v1/chat/completions
#   Ollama:           http://localhost:11434/v1/chat/completions
#   OpenAI:           https://api.openai.com/v1/chat/completions
#   DeepSeek:         https://api.deepseek.com/v1/chat/completions
ASK_LLM_URL=

# Model alias / id. Examples: qwen3.6-35b, gpt-4o-mini, deepseek-chat
ASK_LLM_MODEL=

# Bearer token. LiteLLM accepts "dummy" by default. For OpenAI etc., put real key.
ASK_LLM_AUTH=dummy

# Virtual key for LiteLLM spend tracking (takes precedence over ASK_LLM_AUTH).
# Generate: curl http://<litellm>/key/generate -H "Authorization: Bearer <master>" -d '{"key_alias":"ask-llm","user_id":"ask-llm"}'
ASK_LLM_API_KEY=

# Network timeout in seconds.
ASK_LLM_TIMEOUT=180
