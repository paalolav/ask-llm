#!/usr/bin/env python3
"""Shim entrypoint. Re-exports ask_llm.main so setup.sh symlinks keep working
without requiring a pipx install. pipx users get the same main via
[project.scripts] in pyproject.toml.
"""
import sys
from pathlib import Path

# Resolve symlinks so PATH-installed symlinks still find the package source.
_HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(_HERE.parent))

from ask_llm import main  # noqa: E402

if __name__ == "__main__":
    main()
